# Copy this file to .env and fill in your own values.
# Get Spotify keys at https://developer.spotify.com/dashboard

SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Must match a Redirect URI added in your Spotify app settings exactly
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/callback

# Where the backend sends users after login (also allowed through CORS)
FRONTEND_URL=http://127.0.0.1:5173

# Where the frontend finds the backend (leave blank to use the live api.songshelf.app)
VITE_BACKEND_URL=http://127.0.0.1:4000

PORT=4000
